{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "chatjimmy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "chatjimmy (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "not-required"
      },
      "models": {
        "llama3.1-8B": {
          "name": "Llama 3.1 8B (chatjimmy)",
          "tool_call": false,
          "temperature": false,
          "limit": {
            "context": 6064,
            "output": 2400
          }
        }
      }
    }
  }
}
